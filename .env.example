# Supabase session pooler connection string
DATABASE_URL=

GEMINI_API_KEY=

# Swapping a model is a one line change here. Never a preview model.
# There is no fallback chain: every caller names its tier and a failure is reported,
# because the free tier allows 20 requests per day per model.
CHEAP_MODEL=
STRONG_MODEL=
# Optional. Seconds between model calls, default 4.0 (roughly 15 rpm).
LLM_MIN_INTERVAL=
